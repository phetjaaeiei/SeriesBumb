BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
ADMIN_EMAILS="admin@example.com"
FIREBASE_SERVICE_ACCOUNT_JSON='{"client_email":"service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"}'
