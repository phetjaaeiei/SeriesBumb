{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seriesbumb",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seriesbumb",
      "database_id": "7dc0ce4b-611d-4188-b6c9-9af328f305d3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://seriesbumb.phetjaa.workers.dev",
    "FIREBASE_STORAGE_BUCKET": "seriesbumb-32f9e.firebasestorage.app",
    "SUPABASE_URL": "https://lgtdhbeocizxxvptofdb.supabase.co",
    "SUPABASE_AUDIO_BUCKET": "SeriesBumb",
    "AUDIO_FIREBASE_ENABLED": "false",
    "FIREBASE_IMAGE_UPLOADS_ENABLED": "false",
    "IMAGE_BASE_URL": "https://firebasestorage.googleapis.com/v0/b/seriesbumb-32f9e.firebasestorage.app/o",
    "CF_BEACON_TOKEN": ""
  },
  "observability": {
    "enabled": true
  }
}
