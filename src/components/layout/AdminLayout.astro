---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string }
const { title } = Astro.props;
// Second layer behind guardPaths: admin page content never renders for anyone else,
// even if a middleware change stops matching a path.
const allowed = Astro.locals.user?.role === 'admin';
if (!allowed) Astro.response.status = 403;
---
{allowed
  ? <BaseLayout title={title} noindex admin><slot /></BaseLayout>
  : <BaseLayout title="หน้านี้สำหรับแอดมิน" noindex><div class="error-page"><h1>หน้านี้สำหรับแอดมิน</h1><p>บัญชีนี้ไม่มีสิทธิ์เปิดหน้านี้</p><a class="button" href="/">กลับหน้าแรก</a></div></BaseLayout>}
