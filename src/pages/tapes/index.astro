---
import { db } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import TapeResults from '../../components/ui/TapeResults.astro';
import { loadTapes } from '../../loaders/tapes';
import { CATALOG_LETTERS } from '../../domain/thai';

const params = Astro.url.searchParams;
const { genres, decade, genre, releaseType, allowedSorts, sort, view, showLetters, letter, page } = await loadTapes(db(), params);
const canonicalParams = new URLSearchParams();
if (decade) canonicalParams.set('decade', `${decade}s`);
if (genre) canonicalParams.set('genre', genre.slug);
if (releaseType) canonicalParams.set('type', releaseType);
if (sort !== 'new') canonicalParams.set('sort', sort);
if (letter) canonicalParams.set('l', letter);
const canonicalPath = `/tapes${canonicalParams.size ? `?${canonicalParams}` : ''}`;
const tableParams = new URLSearchParams(params); tableParams.delete('view'); tableParams.delete('cursor');
const gridParams = new URLSearchParams(tableParams); gridParams.set('view', 'grid');
---
<BaseLayout title="เทปทั้งหมด" description="ค้นหาและเปิดดูตลับเทปเพลงไทยตามยุค แนวเพลง และประเภท" canonicalPath={canonicalPath} noindex={params.size > 0}>
  <h1>เทปทั้งหมด</h1>
  <p class="page-lede">เลือกดูตามยุค แนวเพลง หรือเรียงรายการในคลัง</p>
  <div class="section">
    <FilterBar params={params} genres={genres} sorts={allowedSorts} />
    {showLetters && <nav class="letter-bar" aria-label="ตัวอักษรชื่อเทป">
      <a href={`/tapes?sort=title${view === 'grid' ? '&view=grid' : ''}`} aria-current={!letter ? 'page' : undefined}>ทั้งหมด</a>
      {CATALOG_LETTERS.map(value => <a href={`/tapes?sort=title&l=${encodeURIComponent(value)}${view === 'grid' ? '&view=grid' : ''}`} aria-current={letter === value ? 'page' : undefined}>{value}</a>)}
    </nav>}
    <div class="section-heading">
      <h2>รายการเทป</h2>
      <nav class="view-switch" aria-label="มุมมองรายการ">
        <a href={`/tapes${tableParams.size ? `?${tableParams}` : ''}`} aria-current={view === 'table' ? 'page' : undefined}>ตาราง</a>
        <a href={`/tapes?${gridParams}`} aria-current={view === 'grid' ? 'page' : undefined}>ปกเทป</a>
      </nav>
    </div>
    <TapeResults items={page.items} nextCursor={page.nextCursor} path="/tapes" params={params} view={view} emptyText="ไม่พบเทปตามตัวกรองนี้" />
    {!page.items.length && params.size > 0 && <a href="/tapes">ล้างตัวกรอง</a>}
  </div>
</BaseLayout>
