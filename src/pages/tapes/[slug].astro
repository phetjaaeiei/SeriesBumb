---
import { env } from 'cloudflare:workers';
import { getConfig } from '../../config/config';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import Tabs from '../../components/ui/Tabs.astro';
import Tag from '../../components/ui/Tag.astro';
import ExpandableText from '../../components/ui/ExpandableText.astro';
import { formatDuration, formatYear, releaseTypeLabel } from '../../domain/format';
import { getTapeBySlug } from '../../repositories/tapes.repo';
import { imageUrl } from '../../domain/urls';
import EngagementButton from '../../components/islands/EngagementButton';
import Comments from '../../components/islands/Comments';
import { listComments } from '../../services/comments';
import { listCatalogSources } from '../../services/catalog-sources';
import { CorrectionForm, ReviewForm } from '../../components/islands/ContributionForms';
import { publicTapeEditions } from '../../services/catalog-relations';
import { creditsForTarget } from '../../services/person-credits';

const slug = Astro.params.slug ?? '';
const isAdmin = Astro.locals.user?.role === 'admin';
const tape = await getTapeBySlug(env.DB, slug, isAdmin);
if (!tape) return Astro.rewrite('/404');
const unpublished = tape.status !== 'published';
const catalogSources = await listCatalogSources(env.DB, 'tape', tape.id);
const credits = await creditsForTarget(env.DB, 'tape', tape.id);
const editions = !unpublished ? await publicTapeEditions(env.DB, tape.id) : [];
const artistNames = tape.artists.map(artist => artist.name).join(' / ') || 'รวมศิลปิน';
const cover = tape.images.find(image => image.id === tape.coverImageId) ?? tape.images.find(image => image.kind === 'front') ?? tape.images[0];
const gallery = cover ? [cover, ...tape.images.filter(image => image.id !== cover.id)] : [];
const ogImage = tape.ogImageKey && env.IMAGE_BASE_URL ? imageUrl(tape.ogImageKey, env.IMAGE_BASE_URL) : undefined;
const description = (tape.description || `เทป ${tape.title} – ${artistNames}${tape.year ? ` (พ.ศ. ${tape.year + 543})` : ''}${tape.labelName ? ` ค่าย ${tape.labelName}` : ''} | ซีรี่ย์บั้ม เทปเพลง`).replace(/\s+/gu, ' ').slice(0, 155);
const items = [
  { label: 'ประเภท', value: releaseTypeLabel(tape.releaseType) },
  { label: 'ปี', value: formatYear(tape.year) },
  { label: 'ค่าย', value: tape.labelName, href: tape.labelSlug ? `/labels/${encodeURIComponent(tape.labelSlug)}` : undefined },
  { label: 'รหัสตลับ', value: tape.catalogNo },
  { label: 'แนวเพลง', value: tape.genres.map(genre => genre.name).join(', ') || null },
];
const sides = ['A', 'B', 'C', 'D'].filter(side => tape.tracks.some(track => track.side === side));
const sideGroups = sides.map(side => {
  const tracks = tape.tracks.filter(track => track.side === side);
  return { side, tracks, total: tracks.reduce((seconds, track) => seconds + (track.durationSec ?? 0), 0), incomplete: tracks.some(track => track.durationSec === null) };
});
const relatedStatement = tape.artists[0]
  ? env.DB.prepare(`SELECT t.slug, t.title, t.year FROM tape_artist ta JOIN artist a ON a.id = ta.artistId JOIN tape t ON t.id = ta.tapeId WHERE a.slug = ? AND t.status = 'published' AND t.id != ? ORDER BY t.yearSort, t.id LIMIT 8`).bind(tape.artists[0].slug, tape.id)
  : tape.labelId ? env.DB.prepare("SELECT slug, title, year FROM tape WHERE labelId = ? AND status = 'published' AND id != ? ORDER BY yearSort, id LIMIT 8").bind(tape.labelId, tape.id) : null;
const [collections, related] = await Promise.all([
  env.DB.prepare(`SELECT c.slug, c.title FROM collection_item ci JOIN collection c ON c.id = ci.collectionId WHERE ci.tapeId = ? AND c.status = 'published' ORDER BY c.position`).bind(tape.id).all<{ slug: string; title: string }>(),
  relatedStatement?.all<{ slug: string; title: string; year: number | null }>() ?? Promise.resolve({ results: [] as { slug: string; title: string; year: number | null }[] }),
]);
const viewerId = Astro.locals.user?.id;
const engagement = !unpublished && viewerId ? await env.DB.prepare('SELECT EXISTS(SELECT 1 FROM tape_like WHERE userId = ? AND tapeId = ?) AS liked, EXISTS(SELECT 1 FROM tape_owner WHERE userId = ? AND tapeId = ?) AS owned').bind(viewerId, tape.id, viewerId, tape.id).first<{ liked: number; owned: number }>() : null;
const firstComments = !unpublished ? await listComments(env.DB, { tapeId: tape.id }, null, viewerId) : null;
const publicReviews = !unpublished ? (await env.DB.prepare("SELECT r.id, r.body, r.rating, r.createdAt, u.name AS authorName FROM review r JOIN user u ON u.id = r.userId WHERE r.tapeId = ? AND r.status = 'published' ORDER BY r.createdAt DESC, r.id DESC LIMIT 20").bind(tape.id).all<{ id: string; body: string; rating: number; createdAt: number; authorName: string }>()).results : [];
const turnstileSiteKey = getConfig(env).turnstile?.siteKey ?? null;
---
<BaseLayout title={tape.title} description={description} canonicalPath={`/tapes/${slug}`} ogImage={ogImage} ogImageAlt={`ภาพแชร์เทป ${tape.title}`} ogType="music.album" noindex={unpublished}>
  {unpublished && <p class="draft-banner">ยังไม่เผยแพร่ · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <h1>{tape.title}</h1>
  {isAdmin && <p><a href={`/admin/sources?kind=tape&id=${tape.id}`}>จัดการแหล่งอ้างอิง</a></p>}
  {isAdmin && <p><a href={`/admin/relations?kind=tape&id=${tape.id}`}>จัดการฉบับออกใหม่</a></p>}
  {isAdmin && <p><a href={`/admin/credits?kind=tape&id=${tape.id}`}>จัดการเครดิตบุคคล</a></p>}
  {tape.titleAlt && <p class="subheading">{tape.titleAlt}</p>}
  <p class="entity-byline">{tape.artists.length ? tape.artists.map((artist, index) => <>{index > 0 && ' / '}<a href={`/artists/${encodeURIComponent(artist.slug)}`}>{artist.name}</a></>) : 'รวมศิลปิน'}</p>
  <div class="entity-top">
    <div>
      <InfoBox items={items} />
      <div class="entity-tags">
        {tape.isRare ? <Tag tone="accent">หายาก</Tag> : null}
        {tape.publishedAt && Date.now() - tape.publishedAt < 14 * 24 * 60 * 60 * 1000 ? <Tag>ใหม่</Tag> : null}
      </div>
      {!unpublished && <div class="engagement-counts"><EngagementButton kind="tapeLike" targetId={tape.id} initialValue={Boolean(engagement?.liked)} initialCount={tape.likeCount} authenticated={Boolean(viewerId)} loginNext={Astro.url.pathname} client:visible /><EngagementButton kind="tapeOwned" targetId={tape.id} initialValue={Boolean(engagement?.owned)} initialCount={tape.ownerCount} authenticated={Boolean(viewerId)} loginNext={Astro.url.pathname} client:visible /></div>}
    </div>
    <div class="entity-art">
      {gallery.length && env.IMAGE_BASE_URL ? <div class="tape-gallery" data-lightbox-gallery>
        <a class="tape-gallery-cover" href={imageUrl(gallery[0].fullKey, env.IMAGE_BASE_URL)} data-lightbox-open aria-label={`ขยายรูปปก ${tape.title}`}>
          <img src={imageUrl(gallery[0].fullKey, env.IMAGE_BASE_URL)} width={gallery[0].width} height={gallery[0].height} alt={`ปกหน้า ${tape.title} – ${artistNames}`} decoding="async" />
        </a>
        {gallery.length > 1 && <div class="tape-gallery-thumbs" aria-label="ภาพเทปเพิ่มเติม">
          {gallery.slice(1).map((image, index) => <a href={imageUrl(image.fullKey, env.IMAGE_BASE_URL)} data-lightbox-open aria-label={`ขยายภาพเทป ${index + 2} จาก ${gallery.length}`}>
            <img src={imageUrl(image.thumbKey, env.IMAGE_BASE_URL)} width="68" height="68" loading="lazy" decoding="async" alt={`ภาพเทป ${index + 2}`} />
          </a>)}
        </div>}
        <dialog class="tape-lightbox" data-lightbox aria-label={`ภาพเทป ${tape.title}`}>
          <div class="tape-lightbox-frame">
            <button class="tape-lightbox-close" type="button" data-lightbox-close aria-label="ปิดภาพ">×</button>
            <img data-lightbox-image alt="" />
            <div class="tape-lightbox-controls">
              <button type="button" data-lightbox-prev aria-label="ภาพก่อนหน้า">←</button>
              <span data-lightbox-count aria-live="polite"></span>
              <button type="button" data-lightbox-next aria-label="ภาพถัดไป">→</button>
            </div>
          </div>
        </dialog>
      </div> : <Placeholder label={`ยังไม่มีรูปปก ${tape.title}`} />}
    </div>
  </div>
  <Tabs tabs={[{ id: 'songs', label: 'เพลง' }, { id: 'details', label: 'รายละเอียด' }, { id: 'collections', label: 'Collection' }, { id: 'reviews', label: 'รีวิว' }, { id: 'comments', label: `คอมเมนต์ (${tape.commentCount})` }]}>
    <section id="songs" class="tab-panel" data-tab-panel>
      <h2>เพลง</h2>
      {sideGroups.length ? sideGroups.map(group => <div class="track-side">
        <h3>หน้า {group.side}</h3>
        <table class="data-table"><thead><tr><th scope="col">#</th><th scope="col">ชื่อเพลง</th><th scope="col">ผู้ร้อง</th><th scope="col">ความยาว</th></tr></thead><tbody>
          {group.tracks.map(track => <tr><td class="mono">{track.position}</td><td><a href={`/songs/${encodeURIComponent(track.songSlug)}`}>{track.songTitle}</a>{track.note && <em class="track-note"> · {track.note}</em>}{track.hasLyrics ? <> · <a href={`/songs/${encodeURIComponent(track.songSlug)}#lyrics`}>เนื้อเพลง</a></> : null}</td><td>{track.artists && track.artists !== tape.artists.map(artist => artist.name).join(', ') ? track.artists : '—'}</td><td class="mono">{formatDuration(track.durationSec)}</td></tr>)}
        </tbody></table>
        {group.total > 0 && <p class="track-side-total mono">{group.incomplete ? 'รวมเวลาที่ระบุ' : 'รวมเวลา'} {formatDuration(group.total)}</p>}
      </div>) : <p class="empty-state">ยังไม่มีรายชื่อเพลงในเทปนี้</p>}
    </section>
    <section id="details" class="tab-panel" data-tab-panel>
      <h2>รายละเอียด</h2>
      {tape.description ? <ExpandableText text={tape.description} id="tape-description" /> : <p class="empty-state">ยังไม่มีรายละเอียดเพิ่มเติม</p>}
      {tape.reelUrl && <a href={tape.reelUrl} target="_blank" rel="noopener noreferrer">ดูรีวิวบนเพจ</a>}
      {catalogSources.length > 0 && <div class="section"><h3>แหล่งอ้างอิง</h3><ul class="plain-list">{catalogSources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><p class="soft">{source.claim}</p></li>)}</ul></div>}
      {credits.length > 0 && <div class="section"><h3>เครดิตบุคคล</h3><ul class="plain-list">{credits.map(row => <li><a href={`/people/${encodeURIComponent(row.personSlug)}`}>{row.creditedAs}</a> · {row.role} · <a href={row.sourceUrl} target="_blank" rel="noopener noreferrer">{row.sourceTitle} ↗</a></li>)}</ul></div>}
      {editions.length > 0 && <div class="section"><h3>ฉบับอื่น</h3><ul class="plain-list">{editions.map(item => <li><a href={`/tapes/${encodeURIComponent(item.slug)}`}>{item.title}</a> · {item.format}{item.editionYear ? ` · ${item.editionYear}` : ''}{item.note && ` · ${item.note}`} · <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceTitle} ↗</a></li>)}</ul></div>}
      {!unpublished && <div class="section"><h3>เสนอแก้ข้อมูล</h3><CorrectionForm turnstileSiteKey={turnstileSiteKey} targetKind="tape" targetId={tape.id} authenticated={Boolean(viewerId)} loginNext={Astro.url.pathname} client:visible /></div>}
    </section>
    <section id="collections" class="tab-panel" data-tab-panel>
      <h2>Collection</h2>
      {collections.results.length ? <ul class="plain-list">{collections.results.map(item => <li><a href={`/collections/${encodeURIComponent(item.slug)}`}>{item.title}</a></li>)}</ul> : <p class="empty-state">เทปนี้ยังไม่อยู่ใน Collection</p>}
    </section>
    <section id="reviews" class="tab-panel" data-tab-panel><h2>รีวิวจากสมาชิก</h2>
      {publicReviews.length ? <ul class="plain-list">{publicReviews.map(review => <li class="section"><strong>{review.rating}/5 ดาว · {review.authorName}</strong><p>{review.body}</p></li>)}</ul> : <p class="empty-state">ยังไม่มีรีวิวที่ผ่านการตรวจ</p>}
      {!unpublished && <div class="section"><h3>เขียนรีวิว</h3><ReviewForm turnstileSiteKey={turnstileSiteKey} tapeId={tape.id} authenticated={Boolean(viewerId)} loginNext={Astro.url.pathname} client:visible /></div>}
    </section>
    <section id="comments" class="tab-panel" data-tab-panel>
      <h2>คอมเมนต์</h2>
      {unpublished ? <p class="empty-state">เผยแพร่เทปก่อนจึงเปิดคอมเมนต์ได้</p> : <Comments turnstileSiteKey={turnstileSiteKey} tapeId={tape.id} initialItems={firstComments!.items} initialCursor={firstComments!.nextCursor} initialCount={tape.commentCount} authenticated={Boolean(viewerId)} banned={Boolean(Astro.locals.user?.commentBanned)} loginNext={Astro.url.pathname} client:visible />}
    </section>
  </Tabs>
  {related.results.length > 0 && <section class="section" aria-labelledby="related-tapes-title"><h2 id="related-tapes-title">{tape.artists[0] ? `เทปอื่นของ ${tape.artists[0].name}` : 'เทปอื่นจากค่ายเดียวกัน'}</h2><ul class="plain-list">{related.results.map(item => <li><a href={`/tapes/${encodeURIComponent(item.slug)}`}>{item.title}</a> <span class="mono muted">{item.year ?? '—'}</span></li>)}</ul></section>}
  <CreditLine createdByName={tape.createdByName} createdAt={tape.createdAt} updatedByName={tape.updatedByName} updatedAt={tape.updatedAt} />
  <script>import '../../scripts/lightbox';</script>
</BaseLayout>

<style>
  .tape-gallery { width: 100%; }
  .tape-gallery-cover { display: flex; align-items: center; justify-content: center; min-height: 240px; }
  .tape-gallery-cover img { display: block; max-width: 100%; max-height: 360px; object-fit: contain; }
  .tape-gallery-cover:focus-visible, .tape-gallery-thumbs a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tape-gallery-thumbs { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 0; }
  .tape-gallery-thumbs a { width: 68px; height: 68px; border: 1px solid var(--border); }
  .tape-gallery-thumbs img { width: 100%; height: 100%; object-fit: contain; }
  .tape-lightbox { width: min(960px, calc(100vw - 24px)); max-height: calc(100vh - 24px); padding: 0; border: 1px solid var(--border); background: #14110e; color: var(--text); }
  .tape-lightbox::backdrop { background: rgba(0, 0, 0, .85); }
  .tape-lightbox-frame { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: min(80vh, 720px); padding: 50px 16px 12px; }
  .tape-lightbox-frame > img { display: block; max-width: 100%; max-height: calc(80vh - 110px); object-fit: contain; }
  .tape-lightbox-close { position: absolute; top: 6px; right: 10px; width: 42px; height: 42px; font-size: 30px; line-height: 1; }
  .tape-lightbox-controls { display: flex; align-items: center; gap: 20px; margin-top: auto; padding-top: 12px; }
  .tape-lightbox-controls button { width: 44px; height: 44px; font-size: 21px; }
  .tape-lightbox-controls button:disabled { opacity: .35; cursor: default; }
  .tape-lightbox button { border: 0; background: transparent; color: var(--text); cursor: pointer; }
  .tape-lightbox button:hover { color: var(--accent); }
  .tape-lightbox button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .track-side-total { margin-top: 8px; color: var(--text-muted); font-size: 13px; text-align: right; }
</style>
