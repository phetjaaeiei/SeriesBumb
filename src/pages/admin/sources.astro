---
import { db } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import CatalogSources from '../../components/admin/CatalogSources';
import { loadAdminSources } from '../../loaders/admin/sources';

const model = await loadAdminSources(db(), Astro.url.searchParams);
if (!model) return Astro.rewrite('/404');
const { kind, id, title, sources } = model;
---
<AdminLayout title={`แหล่งอ้างอิง ${title}`}>
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><a href={`/admin/${kind === 'artist' ? 'artists' : kind === 'tape' ? 'tapes' : 'songs'}/${id}`}>{title}</a><span>/</span><span>แหล่งอ้างอิง</span></nav>
  <h1>แหล่งอ้างอิง · {title}</h1>
  <p class="page-lede">ระบุข้อความที่ตรวจสอบได้จากแต่ละแหล่ง แยกจากบันทึกไฟล์ต้นฉบับส่วนตัว</p>
  <CatalogSources entityKind={kind} entityId={id} initial={sources} client:load />
</AdminLayout>
