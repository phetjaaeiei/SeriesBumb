---
import { db } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import PersonCredits from '../../components/admin/PersonCredits';
import { loadAdminCredits } from '../../loaders/admin/credits';
const model = await loadAdminCredits(db(), Astro.url.searchParams);
if (!model) return Astro.rewrite('/404');
const { kind, id, title, people, sources, credits } = model;
---
<AdminLayout title={`เครดิตบุคคล ${title}`}>
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><a href={`/admin/${kind === 'tape' ? 'tapes' : 'songs'}/${id}`}>{title}</a><span>/</span>เครดิต</nav>
  <h1>เครดิตบุคคล · {title}</h1>
  <p class="page-lede">เพิ่มเฉพาะชื่อและหน้าที่ที่อ่านได้จากหลักฐานของรายการนี้ <a href="/admin/people">จัดการบุคคล</a> · <a href={`/admin/sources?kind=${kind}&id=${id}`}>จัดการหลักฐาน</a></p>
  <PersonCredits kind={kind} targetId={id} people={people} sources={sources} initial={credits} client:load />
</AdminLayout>
