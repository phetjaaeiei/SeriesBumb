---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import PersonCredits from '../../components/admin/PersonCredits';
import { creditsForTarget } from '../../services/person-credits';
const kind = Astro.url.searchParams.get('kind');
const id = Astro.url.searchParams.get('id') ?? '';
if ((kind !== 'tape' && kind !== 'song') || !/^[0-9a-f-]{36}$/iu.test(id)) return Astro.rewrite('/404');
const current = await env.DB.prepare(`SELECT title FROM ${kind} WHERE id = ?`).bind(id).first<{ title: string }>();
if (!current) return Astro.rewrite('/404');
const [people, sources, credits] = await Promise.all([
  env.DB.prepare('SELECT id, name AS title FROM person ORDER BY name LIMIT 500').all<{ id: string; title: string }>(),
  env.DB.prepare('SELECT id, title FROM catalog_source WHERE entityKind = ? AND entityId = ? ORDER BY createdAt DESC LIMIT 50').bind(kind, id).all<{ id: string; title: string }>(),
  creditsForTarget(env.DB, kind, id),
]);
---
<AdminLayout title={`เครดิตบุคคล ${current.title}`}>
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><a href={`/admin/${kind === 'tape' ? 'tapes' : 'songs'}/${id}`}>{current.title}</a><span>/</span>เครดิต</nav>
  <h1>เครดิตบุคคล · {current.title}</h1>
  <p class="page-lede">เพิ่มเฉพาะชื่อและหน้าที่ที่อ่านได้จากหลักฐานของรายการนี้ <a href="/admin/people">จัดการบุคคล</a> · <a href={`/admin/sources?kind=${kind}&id=${id}`}>จัดการหลักฐาน</a></p>
  <PersonCredits kind={kind} targetId={id} people={people.results} sources={sources.results} initial={credits} client:load />
</AdminLayout>
