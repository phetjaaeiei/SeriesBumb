---
import { db } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import CatalogRelations from '../../components/admin/CatalogRelations';
import { loadAdminRelations } from '../../loaders/admin/relations';
const model = await loadAdminRelations(db(), Astro.url.searchParams);
if (!model) return Astro.rewrite('/404');
const { kind, id, title, choices, sources, rows } = model;
---
<AdminLayout title={`ความสัมพันธ์ ${title}`}>
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><a href={`/admin/${kind === 'artist' ? 'artists' : 'tapes'}/${id}`}>{title}</a><span>/</span>ความสัมพันธ์</nav>
  <h1>ความสัมพันธ์ · {title}</h1>
  <p class="page-lede">เชื่อมเฉพาะศิลปินหรือฉบับที่มีหลักฐานชัดเจน ฉบับร่างจะไม่แสดงในหน้าสาธารณะ</p>
  {!sources.length && <p><a href={`/admin/sources?kind=${kind}&id=${id}`}>เพิ่มแหล่งอ้างอิงก่อน</a></p>}
  <CatalogRelations kind={kind} entityId={id} choices={choices} sources={sources} initial={rows} client:load />
</AdminLayout>
