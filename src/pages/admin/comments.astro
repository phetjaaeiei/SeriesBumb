---
import { db } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { AdminCommentsTable } from '../../components/admin/CommunityTables';
import { loadAdminComments } from '../../loaders/admin/comments';

const { kind, rows, next } = await loadAdminComments(db(), Astro.url.searchParams);
---
<AdminLayout title="จัดการคอมเมนต์">
  <h1>จัดการคอมเมนต์</h1><p class="page-lede">ตรวจและกู้คืนคอมเมนต์ในคลัง</p>
  <nav class="admin-filters" aria-label="ตัวกรองคอมเมนต์"><a href="/admin/comments" aria-current={kind === 'all' ? 'page' : undefined}>ทั้งหมด</a><a href="/admin/comments?kind=tape" aria-current={kind === 'tape' ? 'page' : undefined}>เทป</a><a href="/admin/comments?kind=song" aria-current={kind === 'song' ? 'page' : undefined}>เพลง</a></nav>
  <section class="section">{rows.length ? <AdminCommentsTable initialRows={rows} client:only="react" /> : <p class="empty-state">ยังไม่มีคอมเมนต์</p>}{next && <p class="pagination"><a class="button" href={`/admin/comments?kind=${kind}&cursor=${encodeURIComponent(next)}`}>หน้าถัดไป</a></p>}</section>
</AdminLayout>
