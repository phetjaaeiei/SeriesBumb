---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { getTapeReadiness } from '../../repositories/tape-readiness.repo';

const tapes = await getTapeReadiness(env.DB);
---
<AdminLayout title="ตรวจข้อมูลเทป">
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><span>ตรวจข้อมูลเทป</span></nav>
  <h1>ตรวจข้อมูลเทปก่อนเผยแพร่</h1>
  <p class="page-lede">รายการนี้ช่วยชี้ข้อมูลที่ยังขาด การมีครบทุกช่องไม่ได้ยืนยันว่าข้อมูลถูกต้อง ต้องตรวจรูปปกและลำดับเพลงกับหลักฐานต้นทางก่อนเผยแพร่</p>
  {tapes.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">เทปฉบับร่าง</th><th scope="col">เพลงที่ผูก</th><th scope="col">สิ่งที่ต้องตรวจ</th><th scope="col">จัดการ</th></tr></thead><tbody>
    {tapes.map(tape => <tr><td>{tape.title}</td><td class="mono">{tape.trackCount}</td><td>{tape.issues.length ? <ul class="readiness-issues">{tape.issues.map(issue => <li>{issue}</li>)}</ul> : 'ข้อมูลเชิงโครงสร้างครบ · ตรวจหลักฐานก่อนเผยแพร่'}</td><td><a href={`/admin/tapes/${encodeURIComponent(tape.id)}`}>เปิดรายการ</a></td></tr>)}
  </tbody></table></div> : <p class="empty-state">ไม่มีเทปฉบับร่างที่รอตรวจ</p>}
</AdminLayout>
<style>
  .readiness-issues { margin: 0; padding-left: 18px; color: var(--text-soft); }
  .readiness-issues li + li { margin-top: 2px; }
</style>
