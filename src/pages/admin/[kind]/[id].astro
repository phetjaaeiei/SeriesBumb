---
import { db, imageBaseUrl } from '../../../platform/runtime';
import AdminLayout from '../../../components/layout/AdminLayout.astro';
import AdminEditor from '../../../components/admin/AdminEditor';
import { loadAdminEditor } from '../../../loaders/admin/editor';

const labelMap = { tapes: 'เทป', songs: 'เพลง', artists: 'ศิลปิน', labels: 'ค่ายเพลง', genres: 'แนวเพลง', collections: 'Collection' } as const;
const model = await loadAdminEditor(db(), Astro.params.kind, Astro.params.id);
if (!model) return Astro.rewrite('/404');
const { kind, record, artistIds, genreIds, tracks, members, items, images, selected } = model;
---
<AdminLayout title={`แก้ไข${labelMap[kind]}`}>
  <nav class="breadcrumb" aria-label="เส้นทาง"><a href="/admin">หลังบ้าน</a><span>/</span><a href={`/admin/${kind}`}>{labelMap[kind]}</a><span>/</span><span>แก้ไข</span></nav>
  <h1>แก้ไข{labelMap[kind]}</h1>
  <AdminEditor kind={kind} record={record} artistIds={artistIds} genreIds={genreIds} tracks={tracks} members={members} items={items} images={images} selected={selected} imageBase={imageBaseUrl()} client:only="react" />
</AdminLayout>
