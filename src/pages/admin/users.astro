---
import { db, config } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { AdminUsersTable } from '../../components/admin/CommunityTables';
import { loadAdminUsers } from '../../loaders/admin/users';

const { query, rows, next, canManageRoles: manageRoles } = await loadAdminUsers(db(), Astro.url.searchParams, Astro.locals.user, config().auth.adminEmails);
---
<AdminLayout title="จัดการผู้ใช้">
  <h1>จัดการผู้ใช้</h1><p class="page-lede">แต่งตั้งแอดมินและจัดการสิทธิ์คอมเมนต์</p>
  <form class="search-page-form section" method="get" action="/admin/users"><label class="sr-only" for="user-search">ค้นหาชื่อหรืออีเมล</label><input id="user-search" class="field" type="search" name="q" value={query} placeholder="ค้นหาชื่อหรืออีเมล" /><button class="button" type="submit">ค้นหา</button></form>
  <section class="section"><h2>รายชื่อสมาชิก</h2>{rows.length ? <AdminUsersTable initialRows={rows} canManageRoles={manageRoles} client:only="react" /> : <p class="empty-state">ไม่พบสมาชิก</p>}{next && <p class="pagination"><a class="button" href={`/admin/users?q=${encodeURIComponent(query)}&cursor=${encodeURIComponent(next)}`}>หน้าถัดไป</a></p>}</section>
</AdminLayout>
