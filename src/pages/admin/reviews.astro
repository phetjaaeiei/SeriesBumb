---
import { db } from '../../platform/runtime';
import AdminLayout from '../../components/layout/AdminLayout.astro';
import ModerationQueue from '../../components/admin/ModerationQueue';
import { loadAdminReviews } from '../../loaders/admin/reviews';

const { reviews, corrections } = await loadAdminReviews(db());
---
<AdminLayout title="ตรวจรีวิวและข้อเสนอ">
  <h1>ตรวจรีวิวและข้อเสนอ</h1>
  <p class="page-lede">ข้อความจากสมาชิกไม่เผยแพร่หรือแก้ข้อมูลคลังจนกว่าแอดมินจะตรวจ</p>
  <ModerationQueue reviews={reviews} corrections={corrections} client:load />
</AdminLayout>
