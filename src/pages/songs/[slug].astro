---
import { db, config, imageBaseUrl } from '../../platform/runtime';
import { CorrectionForm } from '../../components/islands/ContributionForms';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import Tabs from '../../components/ui/Tabs.astro';
import { formatYear } from '../../domain/format';
import { imageUrl } from '../../domain/urls';
import { presentSongNotes } from '../../domain/song-notes';
import EngagementButton from '../../components/islands/EngagementButton';
import Comments from '../../components/islands/Comments';
import { loadSongDetail } from '../../loaders/song-detail';

const slug = Astro.params.slug ?? '';
const admin = Astro.locals.user?.role === 'admin';
const model = await loadSongDetail(db(), slug, Astro.locals.user);
if (!model) return Astro.rewrite('/404');
const { song, publicSong, catalogSources, credits, artists, tapes, liked, firstComments } = model;
const singerNames = artists.map(row => row.name).join(' / ') || '—';
const songNotes = presentSongNotes(song.notes);
const firstOg = tapes.find(row => row.ogImageKey)?.ogImageKey;
const ogImage = firstOg && imageBaseUrl() ? imageUrl(firstOg, imageBaseUrl()) : undefined;
const tabs = [{ id: 'tapes', label: 'อยู่ในเทป' }];
if (song.lyrics) tabs.push({ id: 'lyrics', label: 'เนื้อเพลง' });
tabs.push({ id: 'comments', label: `คอมเมนต์ (${song.commentCount})` });
const viewerId = Astro.locals.user?.id;
const turnstileSiteKey = config().turnstile?.siteKey ?? null;
---
<BaseLayout title={song.title} description={`ข้อมูลเพลง ${song.title} โดย ${singerNames} | ซีรี่ย์บั้ม คลังเทปเพลงไทย`} canonicalPath={`/songs/${slug}`} ogImage={ogImage} noindex={!publicSong}>
  {!publicSong && <p class="draft-banner">เพลงฉบับร่าง · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <h1>{song.title}</h1>{song.titleAlt && <p class="subheading">{song.titleAlt}</p>}
  {admin && <p><a href={`/admin/sources?kind=song&id=${song.id}`}>จัดการแหล่งอ้างอิง</a> · <a href={`/admin/credits?kind=song&id=${song.id}`}>จัดการเครดิต</a></p>}
  <InfoBox items={[{ label: 'ผู้ร้อง', value: singerNames }, { label: 'ความยาว', value: songNotes.duration }, { label: 'คำร้อง', value: song.lyricist }, { label: 'ทำนอง', value: song.composer }, { label: 'เรียบเรียง', value: song.arranger }]} />
  {publicSong && <p class="engagement-counts"><EngagementButton kind="songLike" targetId={song.id} initialValue={liked} initialCount={song.likeCount} authenticated={Boolean(viewerId)} loginNext={Astro.url.pathname} client:visible /></p>}
  {songNotes.publicNotes.length > 0 && <section class="section song-note" aria-labelledby="song-note-title"><h2 id="song-note-title">หมายเหตุข้อมูล</h2>{songNotes.publicNotes.map(note => <p>{note}</p>)}</section>}
  {admin && songNotes.sourceNotes && <details class="source-notes section"><summary>ข้อมูลต้นทางสำหรับแอดมิน</summary><p class="long-text">{songNotes.sourceNotes}</p></details>}
  {credits.length > 0 && <section class="section"><h2>เครดิตบุคคล</h2><ul class="plain-list">{credits.map(row => <li><a href={`/people/${encodeURIComponent(row.personSlug)}`}>{row.creditedAs}</a> · {row.role} · <a href={row.sourceUrl} target="_blank" rel="noopener noreferrer">{row.sourceTitle} ↗</a></li>)}</ul></section>}
  {catalogSources.length > 0 && <section class="section"><h2>แหล่งอ้างอิง</h2><ul class="plain-list">{catalogSources.map(row => <li><a href={row.url} target="_blank" rel="noopener noreferrer">{row.title} ↗</a><p class="soft">{row.claim}</p></li>)}</ul></section>}
  <Tabs tabs={tabs}>
    <section id="tapes" class="tab-panel" data-tab-panel><h2>อยู่ในเทป</h2>
      {tapes.length ? <table class="data-table"><thead><tr><th scope="col">เทป</th><th scope="col">ปี</th><th scope="col">ตำแหน่ง</th></tr></thead><tbody>{tapes.map(row => <tr><td><a href={`/tapes/${encodeURIComponent(row.slug)}#songs`}>{row.title}</a></td><td class="mono">{formatYear(row.year)}</td><td class="mono">หน้า {row.side} #{row.position}</td></tr>)}</tbody></table> : <p class="empty-state">ข้อมูลเทปของเพลงนี้ยังอยู่ระหว่างตรวจสอบ</p>}
    </section>
    {song.lyrics && <section id="lyrics" class="tab-panel" data-tab-panel><h2>เนื้อเพลง</h2><p class="long-text">{song.lyrics}</p></section>}
    <section id="comments" class="tab-panel" data-tab-panel><h2>คอมเมนต์</h2>{firstComments ? <Comments turnstileSiteKey={turnstileSiteKey} songId={song.id} initialItems={firstComments.items} initialCursor={firstComments.nextCursor} initialCount={song.commentCount} authenticated={Boolean(viewerId)} banned={Boolean(Astro.locals.user?.commentBanned)} loginNext={Astro.url.pathname} client:visible /> : <p class="empty-state">เพลงนี้ยังไม่อยู่ในเทปที่เผยแพร่</p>}</section>
  </Tabs>
  <CreditLine createdByName={song.createdByName} createdAt={song.createdAt} updatedByName={song.updatedByName} updatedAt={song.updatedAt} />
  <section class="section"><h2>เสนอแก้ข้อมูลเพลง</h2><CorrectionForm turnstileSiteKey={turnstileSiteKey} targetKind="song" targetId={song.id} authenticated={Boolean(Astro.locals.user)} loginNext={Astro.url.pathname} client:visible /></section>
</BaseLayout>
