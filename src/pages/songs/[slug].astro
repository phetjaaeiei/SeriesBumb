---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import Tabs from '../../components/ui/Tabs.astro';
import { formatYear } from '../../lib/format';
import { imageUrl } from '../../lib/urls';

const slug = Astro.params.slug ?? '';
const admin = Astro.locals.user?.role === 'admin';
const song = await env.DB.prepare(`SELECT s.*, creator.name AS createdByName, editor.name AS updatedByName FROM song s LEFT JOIN user creator ON creator.id = s.createdBy LEFT JOIN user editor ON editor.id = s.updatedBy WHERE s.slug = ? ${admin ? '' : 'AND s.publishedTapeCount > 0'}`).bind(slug).first<{ id: string; title: string; titleAlt: string | null; lyricist: string | null; composer: string | null; arranger: string | null; lyrics: string | null; notes: string | null; likeCount: number; commentCount: number; publishedTapeCount: number; createdAt: number; updatedAt: number; createdByName: string | null; updatedByName: string | null }>();
if (!song) return Astro.rewrite('/404');
const [artists, tapes] = await Promise.all([
  env.DB.prepare('SELECT a.name, a.slug FROM song_artist sa JOIN artist a ON a.id = sa.artistId WHERE sa.songId = ? ORDER BY sa.position').bind(song.id).all<{ name: string; slug: string }>(),
  env.DB.prepare(`SELECT t.slug, t.title, t.year, t.ogImageKey, tt.side, tt.position FROM tape_track tt JOIN tape t ON t.id = tt.tapeId WHERE tt.songId = ? AND t.status = 'published' ORDER BY t.yearSort, t.id, tt.side, tt.position LIMIT 100`).bind(song.id).all<{ slug: string; title: string; year: number | null; ogImageKey: string | null; side: string; position: number }>(),
]);
const singerNames = artists.results.map(row => row.name).join(' / ') || '—';
const firstOg = tapes.results.find(row => row.ogImageKey)?.ogImageKey;
const ogImage = firstOg && env.IMAGE_BASE_URL ? imageUrl(firstOg, env.IMAGE_BASE_URL) : undefined;
const tabs = [{ id: 'tapes', label: 'อยู่ในเทป' }];
if (song.lyrics) tabs.push({ id: 'lyrics', label: 'เนื้อเพลง' });
tabs.push({ id: 'comments', label: `คอมเมนต์ (${song.commentCount})` });
---
<BaseLayout title={song.title} description={`เพลง ${song.title} โดย ${singerNames} อยู่ใน ${song.publishedTapeCount} เทป | ซีรี่ย์บั้ม เทปเพลง`} canonicalPath={`/songs/${slug}`} ogImage={ogImage} noindex={song.publishedTapeCount === 0}>
  {song.publishedTapeCount === 0 && <p class="draft-banner">ยังไม่อยู่ในเทปเผยแพร่ · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <h1>{song.title}</h1>{song.titleAlt && <p class="subheading">{song.titleAlt}</p>}
  <InfoBox items={[{ label: 'ผู้ร้อง', value: singerNames }, { label: 'คำร้อง', value: song.lyricist }, { label: 'ทำนอง', value: song.composer }, { label: 'เรียบเรียง', value: song.arranger }]} />
  <p class="engagement-counts">ถูกใจ <strong class="mono">{song.likeCount}</strong></p>
  {song.notes && <p class="long-text section soft">{song.notes}</p>}
  <Tabs tabs={tabs}>
    <section id="tapes" class="tab-panel" data-tab-panel><h2>อยู่ในเทป</h2>
      {tapes.results.length ? <table class="data-table"><thead><tr><th scope="col">เทป</th><th scope="col">ปี</th><th scope="col">ตำแหน่ง</th></tr></thead><tbody>{tapes.results.map(row => <tr><td><a href={`/tapes/${encodeURIComponent(row.slug)}#songs`}>{row.title}</a></td><td class="mono">{formatYear(row.year)}</td><td class="mono">หน้า {row.side} #{row.position}</td></tr>)}</tbody></table> : <p class="empty-state">ยังไม่มีเทปเผยแพร่ที่มีเพลงนี้</p>}
    </section>
    {song.lyrics && <section id="lyrics" class="tab-panel" data-tab-panel><h2>เนื้อเพลง</h2><p class="long-text">{song.lyrics}</p></section>}
    <section id="comments" class="tab-panel" data-tab-panel><h2>คอมเมนต์</h2><p class="empty-state">ระบบคอมเมนต์กำลังจัดเตรียม</p></section>
  </Tabs>
  <CreditLine createdByName={song.createdByName} createdAt={song.createdAt} updatedByName={song.updatedByName} updatedAt={song.updatedAt} />
</BaseLayout>
