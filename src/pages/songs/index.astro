---
import { db } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { loadSongs } from '../../loaders/songs';

const { hasCursor, songs, next } = await loadSongs(db(), Astro.url.searchParams);
---
<BaseLayout title="เพลงทั้งหมด" description="เปิดดูข้อมูลเพลงในคลังซีรี่ย์บั้ม ไฟล์เสียงต้นฉบับเก็บไว้ในคลังส่วนตัว" canonicalPath="/songs" noindex={hasCursor}>
  <h1>เพลงในคลัง</h1>
  <p class="page-lede">ข้อมูลเพลงที่บันทึกจากเทปและแหล่งเก็บเก่า ไฟล์เสียงต้นฉบับเก็บไว้ในคลังส่วนตัว</p>
  {songs.length ? <div class="table-wrap section"><table class="data-table"><thead><tr><th scope="col">เพลง</th><th scope="col">ศิลปิน</th></tr></thead><tbody>
    {songs.map(song => <tr><td><a href={`/songs/${encodeURIComponent(song.slug)}`}>{song.title}</a></td><td>{song.artists || 'ไม่ระบุ'}</td></tr>)}
  </tbody></table></div> : <p class="empty-state section">ยังไม่มีเพลงที่เผยแพร่</p>}
  {next && <nav class="pagination" aria-label="หน้ารายการเพลง"><a class="button" href={`/songs?cursor=${encodeURIComponent(next)}`} rel="nofollow">เพลงหน้าถัดไป →</a></nav>}
</BaseLayout>
