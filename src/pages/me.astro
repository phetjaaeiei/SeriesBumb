---
import { db, imageBaseUrl } from '../platform/runtime';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Tabs from '../components/ui/Tabs.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import { formatYear } from '../domain/format';
import { imageUrl } from '../domain/urls';
import { loadMe, type MeTab as Tab } from '../loaders/me';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=%2Fme', 302);
const { likedTapes, likedSongs, owned } = await loadMe(db(), Astro.url.searchParams, user);
const nextLink = (tab: Tab, value: string) => `/me?tab=${tab}&cursor=${encodeURIComponent(value)}#${tab}`;
---
<BaseLayout title="ของฉัน" noindex>
  <h1>ของฉัน</h1>
  <p class="page-lede">เทปและเพลงที่คุณบันทึกไว้</p>
  <p><a href="/me/submissions">ดูรีวิวและข้อเสนอแก้ข้อมูลของฉัน →</a></p>
  <Tabs tabs={[{ id: 'liked-tapes', label: 'เทปที่ถูกใจ' }, { id: 'liked-songs', label: 'เพลงที่ถูกใจ' }, { id: 'owned', label: 'เทปที่มี' }]}>
    <section id="liked-tapes" class="tab-panel" data-tab-panel><h2>เทปที่ถูกใจ</h2>
      {likedTapes.items.length ? <ul class="saved-list">{likedTapes.items.map(item => <li><a href={`/tapes/${encodeURIComponent(item.slug)}`} class="saved-item"><span class="saved-cover">{item.coverThumbKey && imageBaseUrl() ? <img src={imageUrl(item.coverThumbKey, imageBaseUrl())} alt="" loading="lazy" /> : <Placeholder label="ไม่มีรูป" />}</span><span><strong>{item.title}</strong><small>{formatYear(item.year)}</small></span></a></li>)}</ul> : <p class="empty-state">ยังไม่มีเทปที่ถูกใจ <a href="/tapes">เลือกดูเทปในคลัง</a></p>}
      {likedTapes.next && <p class="pagination"><a class="button" href={nextLink('liked-tapes', likedTapes.next)} rel="nofollow">หน้าถัดไป</a></p>}
    </section>
    <section id="liked-songs" class="tab-panel" data-tab-panel><h2>เพลงที่ถูกใจ</h2>
      {likedSongs.items.length ? <ul class="saved-list">{likedSongs.items.map(item => <li><a href={`/songs/${encodeURIComponent(item.slug)}`} class="saved-item"><span><strong>{item.title}</strong><small>{item.publishedTapeCount > 0 ? `อยู่ในเทป ${item.publishedTapeCount.toLocaleString('th-TH')} ชุด` : 'ข้อมูลเพลงในคลัง'}</small></span></a></li>)}</ul> : <p class="empty-state">ยังไม่มีเพลงที่ถูกใจ <a href="/songs">เลือกดูเพลงในคลัง</a></p>}
      {likedSongs.next && <p class="pagination"><a class="button" href={nextLink('liked-songs', likedSongs.next)} rel="nofollow">หน้าถัดไป</a></p>}
    </section>
    <section id="owned" class="tab-panel" data-tab-panel><h2>เทปที่มี</h2>
      {owned.items.length ? <ul class="saved-list">{owned.items.map(item => <li><a href={`/tapes/${encodeURIComponent(item.slug)}`} class="saved-item"><span class="saved-cover">{item.coverThumbKey && imageBaseUrl() ? <img src={imageUrl(item.coverThumbKey, imageBaseUrl())} alt="" loading="lazy" /> : <Placeholder label="ไม่มีรูป" />}</span><span><strong>{item.title}</strong><small>{formatYear(item.year)}</small></span></a></li>)}</ul> : <p class="empty-state">ยังไม่ได้บันทึกเทปที่มี <a href="/tapes">เลือกดูเทปในคลัง</a></p>}
      {owned.next && <p class="pagination"><a class="button" href={nextLink('owned', owned.next)} rel="nofollow">หน้าถัดไป</a></p>}
    </section>
  </Tabs>
</BaseLayout>
