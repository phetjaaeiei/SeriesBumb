---
import { env } from 'cloudflare:workers';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getConfig } from '../config/config';
import { safeNextPath } from '../lib/urls';

const next = safeNextPath(Astro.url.searchParams.get('next'), env.SITE_URL);
// ?reauth=1: signed-in admins confirm their identity again before destructive actions.
const reauth = Astro.url.searchParams.get('reauth') === '1';
if (Astro.locals.user && !reauth) return Astro.redirect(next);
const failed = Astro.url.searchParams.has('error');
const turnstileSiteKey = getConfig(env).turnstile?.siteKey ?? null;
---
<BaseLayout title="เข้าสู่ระบบ" noindex>
  <div class="error-page">
    <h1>เข้าสู่ระบบ</h1>
    {reauth && Astro.locals.user
      ? <p>ยืนยันตัวตนอีกครั้งด้วยบัญชี Google ก่อนลบข้อมูลหรือเปลี่ยนสิทธิ์ แล้วกลับไปทำรายการเดิมได้ภายใน 15 นาที</p>
      : <p>ใช้บัญชี Google เพื่อบันทึกเทปที่คุณมี กดถูกใจ และร่วมพูดคุยใต้เทปหรือเพลง</p>}
    {failed && <p class="error-text" role="alert">เข้าสู่ระบบไม่สำเร็จ ลองอีกครั้ง</p>}
    {turnstileSiteKey && <div class="turnstile-field" data-turnstile-sitekey={turnstileSiteKey}></div>}
    <button class="button button-primary" type="button" data-google-login data-next={next}>เข้าสู่ระบบด้วย Google</button>
    <p class="help-text section">ชื่อและรูปจาก Google จะแสดงต่อสาธารณะเมื่อคุณเขียนคอมเมนต์</p>
  </div>
  <script>import '../scripts/login';</script>
</BaseLayout>
