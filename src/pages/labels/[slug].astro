---
import { db, imageBaseUrl } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import TapeResults from '../../components/ui/TapeResults.astro';
import ExpandableText from '../../components/ui/ExpandableText.astro';
import { getTapePage } from '../../repositories/tapes.repo';
import { imageUrl } from '../../domain/urls';
const slug = Astro.params.slug ?? '';
const admin = Astro.locals.user?.role === 'admin';
const label = await db().prepare(`SELECT l.*, creator.name AS createdByName, editor.name AS updatedByName FROM label l LEFT JOIN user creator ON creator.id = l.createdBy LEFT JOIN user editor ON editor.id = l.updatedBy WHERE l.slug = ? ${admin ? '' : 'AND l.publishedTapeCount > 0'}`).bind(slug).first<{ id: string; name: string; nameAlt: string | null; description: string; logoKey: string | null; publishedTapeCount: number; createdAt: number; updatedAt: number; createdByName: string | null; updatedByName: string | null }>();
if (!label) return Astro.rewrite('/404');
const range = await db().prepare("SELECT MIN(year) AS firstYear, MAX(year) AS lastYear FROM tape WHERE labelId = ? AND status = 'published' AND year IS NOT NULL").bind(label.id).first<{ firstYear: number | null; lastYear: number | null }>();
const sort = Astro.url.searchParams.get('sort') === 'year' ? 'year' : 'new';
const page = await getTapePage(db(), { labelId: label.id, sort, cursor: Astro.url.searchParams.get('cursor'), pageSize: 50 });
const years = range?.firstYear ? range.lastYear && range.lastYear !== range.firstYear ? `${range.firstYear}–${range.lastYear}` : String(range.firstYear) : '—';
const nextParams = new URLSearchParams(Astro.url.searchParams); nextParams.delete('cursor');
---
<BaseLayout title={label.name} description={(label.description || `ค่ายเพลง ${label.name} มี ${label.publishedTapeCount} เทปในคลัง`).slice(0, 155)} canonicalPath={`/labels/${slug}${sort === 'year' ? '?sort=year' : ''}`} noindex={label.publishedTapeCount === 0 || Astro.url.searchParams.size > 0}>
  <h1>{label.name}</h1>{label.nameAlt && <p class="subheading">{label.nameAlt}</p>}
  {label.publishedTapeCount === 0 && <p class="draft-banner">ยังไม่มีเทปเผยแพร่ · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <div class="entity-top">
    <InfoBox items={[{ label: 'จำนวนเทป', value: `${label.publishedTapeCount} เทป` }, { label: 'ช่วงปี', value: years }]} />
    <div class="entity-art">{label.logoKey && imageBaseUrl() ? <img src={imageUrl(label.logoKey, imageBaseUrl())} width="160" height="160" loading="lazy" decoding="async" alt={`โลโก้ ${label.name}`} /> : <Placeholder label={`ยังไม่มีโลโก้ ${label.name}`} />}</div>
  </div>
  {label.description && <ExpandableText text={label.description} id="label-description" className="section soft" />}
  <section class="section" aria-labelledby="tapes-title"><div class="section-heading"><h2 id="tapes-title">เทปจากค่ายนี้</h2><nav class="view-switch"><a href={`/labels/${slug}`} aria-current={sort === 'new' ? 'page' : undefined}>เพิ่มล่าสุด</a><a href={`/labels/${slug}?sort=year`} aria-current={sort === 'year' ? 'page' : undefined}>ปีเก่าไปใหม่</a></nav></div><TapeResults items={page.items} nextCursor={page.nextCursor} path={`/labels/${slug}`} params={nextParams} showLabel={false} /></section>
  <CreditLine createdByName={label.createdByName} createdAt={label.createdAt} updatedByName={label.updatedByName} updatedAt={label.updatedAt} />
</BaseLayout>
