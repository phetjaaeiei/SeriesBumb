---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TapeResults from '../../components/ui/TapeResults.astro';
import { getTapePage } from '../../lib/queries/tapes';
const slug = Astro.params.slug ?? '';
const genre = await env.DB.prepare('SELECT id, name, publishedTapeCount FROM genre WHERE slug = ?').bind(slug).first<{ id: string; name: string; publishedTapeCount: number }>();
if (!genre) return Astro.rewrite('/404');
const page = await getTapePage(env.DB, { genreId: genre.id, cursor: Astro.url.searchParams.get('cursor') });
---
<BaseLayout title={`แนวเพลง ${genre.name}`} description={`เทปเพลงไทยแนว${genre.name}ในคลังซีรี่ย์บั้ม`} canonicalPath={`/genres/${slug}`} noindex={Astro.url.searchParams.size > 0}>
  <p class="eyebrow"><a href="/genres">แนวเพลง</a></p>
  <h1>{genre.name}</h1>
  <p class="page-lede">{genre.publishedTapeCount.toLocaleString('th-TH')} เทปในคลัง</p>
  <div class="section"><TapeResults items={page.items} nextCursor={page.nextCursor} path={`/genres/${slug}`} params={Astro.url.searchParams} /></div>
</BaseLayout>
