---
import { db } from '../../platform/runtime';
import TapeList from '../../components/ui/TapeList.astro';
import { loadTapesPartial } from '../../loaders/tapes-partial';

export const partial = true;
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const { page, view, showLabel } = await loadTapesPartial(db(), Astro.url.searchParams);
---
<div data-tape-partial data-next-cursor={page.nextCursor ?? undefined}>
  <TapeList items={page.items} view={view} showLabel={showLabel} />
</div>
