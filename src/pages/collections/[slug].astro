---
import { db, imageBaseUrl } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ExpandableText from '../../components/ui/ExpandableText.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import { imageUrl } from '../../domain/urls';
import { loadCollectionDetail } from '../../loaders/collection-detail';
const slug = Astro.params.slug ?? '';
const model = await loadCollectionDetail(db(), slug, Astro.locals.user);
if (!model) return Astro.rewrite('/404');
const { collection, items, coverKey } = model;
---
<BaseLayout title={collection.title} description={(collection.description || `Collection ${collection.title} รวม ${items.length} เทปเพลงไทย`).replace(/\s+/gu, ' ').slice(0, 155)} canonicalPath={`/collections/${slug}`} noindex={collection.status !== 'published'}>
  {collection.status !== 'published' && <p class="draft-banner">ยังไม่เผยแพร่ · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <h1>{collection.title}</h1>
  <div class="entity-top">
    <div>{collection.description ? <ExpandableText text={collection.description} id="collection-description" className="soft" /> : <p class="soft">เทปที่คัดไว้ใน Collection นี้</p>}</div>
    <div class="entity-art">{coverKey && imageBaseUrl() ? <img src={imageUrl(coverKey, imageBaseUrl())} width="240" height="240" loading="lazy" decoding="async" alt={`ปก Collection ${collection.title}`} /> : <Placeholder label="ยังไม่มีรูปปก" />}</div>
  </div>
  <section class="section" aria-labelledby="items-title"><div class="section-heading"><h2 id="items-title">เทปใน Collection</h2></div>
    {items.length ? <table class="data-table"><thead><tr><th scope="col">ลำดับ</th><th scope="col">เทป</th><th scope="col">ปี</th><th scope="col">หมายเหตุ</th></tr></thead><tbody>{items.map(item => <tr><td class="mono">{item.position + 1}</td><td><a href={`/tapes/${encodeURIComponent(item.slug)}`}>{item.title}</a></td><td class="mono">{item.year ?? '—'}</td><td class="soft">{item.note || '—'}</td></tr>)}</tbody></table> : <p class="empty-state">ยังไม่มีเทปเผยแพร่ใน Collection นี้</p>}
  </section>
  <CreditLine createdByName={collection.createdByName} createdAt={collection.createdAt} updatedByName={collection.updatedByName} updatedAt={collection.updatedAt} />
</BaseLayout>
