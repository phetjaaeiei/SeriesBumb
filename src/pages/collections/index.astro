---
import { db, imageBaseUrl } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import { imageUrl } from '../../domain/urls';
import { loadCollections } from '../../loaders/collections';
const { collections } = await loadCollections(db());
---
<BaseLayout title="Collection" canonicalPath="/collections">
  <h1>Collection</h1>
  <p class="page-lede">เทปที่คัดไว้เป็นชุด เปิดดูเรื่องราวผ่านปกและเพลงในแต่ละ Collection</p>
  {collections.length ? <ul class="collection-grid section">{collections.map(item => <li>
    <a class="collection-cover" href={`/collections/${encodeURIComponent(item.slug)}`}>
      {item.displayCoverKey && imageBaseUrl() ? <img src={imageUrl(item.displayCoverKey, imageBaseUrl())} width="240" height="240" loading="lazy" decoding="async" alt={`ปก Collection ${item.title}`} /> : <Placeholder label="ยังไม่มีรูปปก" />}
    </a>
    <a class="collection-title" href={`/collections/${encodeURIComponent(item.slug)}`}>{item.title}</a>
    <span class="muted">{item.tapeCount} เทป</span>
  </li>)}</ul> : <p class="empty-state section">ยังไม่มี Collection ที่เผยแพร่</p>}
</BaseLayout>
