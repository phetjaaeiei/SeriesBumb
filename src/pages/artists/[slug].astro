---
import { db, config, imageBaseUrl } from '../../platform/runtime';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CreditLine from '../../components/layout/CreditLine.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import Tabs from '../../components/ui/Tabs.astro';
import TapeList from '../../components/ui/TapeList.astro';
import ExpandableText from '../../components/ui/ExpandableText.astro';
import { artistStatusLabel, artistTypeLabel, formatYear } from '../../domain/format';
import { imageUrl } from '../../domain/urls';
import type { ReleaseType } from '../../domain/enums';
import { CorrectionForm } from '../../components/islands/ContributionForms';
import { loadArtistDetail } from '../../loaders/artist-detail';

const slug = Astro.params.slug ?? '';
const model = await loadArtistDetail(db(), slug, Astro.url.searchParams, Astro.locals.user);
if (!model) return Astro.rewrite('/404');
const { artist, publicArtist, catalogSources, explicitRelations, members, songs: visibleSongs, nextSongCursor, genreNames, lastLabel, page, appearances, similarArtists, relatedLinks } = model;
const admin = Astro.locals.user?.role === 'admin';
const releaseGroups: { type: ReleaseType; label: string }[] = [
  { type: 'album', label: 'อัลบั้ม' }, { type: 'single', label: 'ซิงเกิล' },
  { type: 'compilation', label: 'รวมศิลปิน' }, { type: 'soundtrack', label: 'เพลงประกอบ' },
  { type: 'other', label: 'อื่น ๆ' },
];
const currentMembers = members.filter(member => member.isCurrent);
const pastMembers = members.filter(member => !member.isCurrent);
const tabs = page.items.length
  ? [{ id: 'discography', label: 'ผลงาน' }]
  : [{ id: 'songs', label: 'เพลงที่ร้อง' }, { id: 'discography', label: 'ผลงาน' }];
if (artist.artistType !== 'solo' && members.length) tabs.push({ id: 'members', label: 'สมาชิก' });
if (page.items.length) tabs.push({ id: 'songs', label: 'เพลงที่ร้อง' });
tabs.push({ id: 'similar', label: 'ศิลปินแนวใกล้กัน' }, { id: 'links', label: 'ลิงก์ที่เกี่ยวข้อง' });
const turnstileSiteKey = config().turnstile?.siteKey ?? null;
---
<BaseLayout title={artist.name} description={(artist.bio || `ข้อมูลศิลปิน ${artist.name} และเพลงในคลัง`).replace(/\s+/gu, ' ').slice(0, 155)} canonicalPath={`/artists/${slug}`} noindex={!publicArtist || Astro.url.searchParams.size > 0}>
  {!publicArtist && <p class="draft-banner">ศิลปินฉบับร่าง · หน้านี้เห็นได้เฉพาะแอดมิน</p>}
  <h1>{artist.name}</h1>{artist.nameAlt && <p class="subheading">{artist.nameAlt}</p>}
  {admin && <p><a href={`/admin/sources?kind=artist&id=${artist.id}`}>จัดการแหล่งอ้างอิง</a></p>}
  {admin && <p><a href={`/admin/relations?kind=artist&id=${artist.id}`}>จัดการความสัมพันธ์ศิลปิน</a></p>}
  <div class="entity-top">
    <InfoBox items={[
      { label: 'ประเภท', value: artistTypeLabel(artist.artistType) },
      { label: 'สถานะ', value: artistStatusLabel(artist.status, artist.artistType), tone: artist.status === 'inactive' || artist.status === 'deceased' ? 'status' : 'default' },
      { label: 'มาจาก', value: artist.province, href: artist.province ? `/artists?province=${encodeURIComponent(artist.province)}` : undefined },
      { label: 'เริ่มทำงาน', value: artist.formedYear ? formatYear(artist.formedYear) : null },
      { label: 'ปีที่ทำงาน', value: artist.yearsActive },
      { label: 'แนวเพลง', value: genreNames.join(', ') || null },
      { label: 'หัวข้อเพลง', value: artist.themes },
      { label: 'ค่ายล่าสุด', value: lastLabel?.name ?? null, href: lastLabel ? `/labels/${encodeURIComponent(lastLabel.slug)}` : undefined },
    ]} />
    <div class="entity-art">{artist.imageKey && imageBaseUrl() ? <img src={imageUrl(artist.imageKey, imageBaseUrl())} width="240" height="240" loading="lazy" decoding="async" alt={`รูป ${artist.name}`} /> : <Placeholder label={`ยังไม่มีรูป ${artist.name}`} />}</div>
  </div>
  {artist.bio && <ExpandableText text={artist.bio} id="artist-bio" className="section soft" />}
  <Tabs tabs={tabs}>
    <section id="discography" class="tab-panel" data-tab-panel><h2>ผลงาน</h2>
      {page.items.length ? releaseGroups.map(group => { const items = page.items.filter(item => item.releaseType === group.type); return items.length ? <div class="section"><h3>{group.label}</h3><TapeList items={items} showLabel={false} /></div> : null; }) : <p class="empty-state">ยังไม่มีเทปของศิลปินนี้ที่เผยแพร่ <a href="#songs">ดูเพลงที่มีข้อมูลแล้ว</a></p>}
      {page.nextCursor && <nav class="pagination" aria-label="ผลงานหน้าถัดไป"><a class="button" href={`/artists/${encodeURIComponent(slug)}?cursor=${encodeURIComponent(page.nextCursor)}#discography`} rel="nofollow">ผลงานหน้าถัดไป →</a></nav>}
      {appearances.length > 0 && <div class="section"><h3>เพลงที่ปรากฏในชุดรวม</h3><div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">เพลง</th><th scope="col">ชุดเทป</th><th scope="col">ปี</th></tr></thead><tbody>{appearances.map(row => <tr><td><a href={`/songs/${encodeURIComponent(row.songSlug)}`}>{row.songTitle}</a></td><td><a href={`/tapes/${encodeURIComponent(row.slug)}`}>{row.title}</a></td><td class="mono">{formatYear(row.year)}</td></tr>)}</tbody></table></div></div>}
    </section>
    {artist.artistType !== 'solo' && members.length > 0 && <section id="members" class="tab-panel" data-tab-panel>
      <h2>สมาชิก</h2>
      {([{ title: 'สมาชิกล่าสุด', rows: currentMembers }, { title: 'อดีตสมาชิก', rows: pastMembers }]).map(group => group.rows.length > 0 && <div class="section">
        <h3>{group.title}</h3>
        <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">ชื่อ</th><th scope="col">หน้าที่ (ปี)</th></tr></thead><tbody>
          {group.rows.map(member => <tr><td>{member.personSlug ? <a href={`/people/${encodeURIComponent(member.personSlug)}`}>{member.name}</a> : member.name}</td><td>{member.role || (!member.years ? '—' : '')}{member.years && <> {member.role && '· '}<span class="mono">{member.years}</span></>}</td></tr>)}
        </tbody></table></div>
      </div>)}
    </section>}
    <section id="songs" class="tab-panel" data-tab-panel><h2>เพลงที่ร้อง</h2>
      {visibleSongs.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">ชื่อ</th><th scope="col">อยู่ในเทปแรก</th><th scope="col">ปี</th></tr></thead><tbody>
        {visibleSongs.map(song => <tr><td><a href={`/songs/${encodeURIComponent(song.slug)}`}>{song.title}</a></td><td>{song.firstTapeSlug && song.firstTapeTitle ? <a href={`/tapes/${encodeURIComponent(song.firstTapeSlug)}`}>{song.firstTapeTitle}</a> : '—'}</td><td class="mono">{formatYear(song.firstTapeYear)}</td></tr>)}
      </tbody></table></div> : <p class="empty-state">ยังไม่มีเพลงที่แสดงในคลัง</p>}
      {nextSongCursor && <nav class="pagination" aria-label="เพลงหน้าถัดไป"><a class="button" href={`/artists/${encodeURIComponent(slug)}?songs_cursor=${encodeURIComponent(nextSongCursor)}#songs`} rel="nofollow">เพลงหน้าถัดไป →</a></nav>}
    </section>
    <section id="similar" class="tab-panel" data-tab-panel><h2>ศิลปินแนวใกล้กัน</h2>
      {explicitRelations.length > 0 && <div class="section"><h3>ความสัมพันธ์ที่มีหลักฐาน</h3><ul class="plain-list">{explicitRelations.map(item => <li><a href={`/artists/${encodeURIComponent(item.slug)}`}>{item.name}</a> · {item.relationType === 'former_name' ? 'ชื่อเดิม' : item.relationType === 'collaboration' ? 'ร่วมงาน' : 'เกี่ยวข้อง'} · <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceTitle} ↗</a></li>)}</ul></div>}
      <p class="soft">แสดงศิลปินที่มีแนวเพลงร่วมกันจากเทปที่เผยแพร่แล้ว</p>
      {similarArtists.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">ศิลปิน</th><th scope="col">แนวเพลงที่ตรงกัน</th></tr></thead><tbody>{similarArtists.map(row => <tr><td><a href={`/artists/${encodeURIComponent(row.slug)}`}>{row.name}</a></td><td class="mono">{row.sharedGenres}</td></tr>)}</tbody></table></div> : <p class="empty-state">ยังไม่มีข้อมูลแนวเพลงของเทปที่เผยแพร่เพียงพอสำหรับแนะนำศิลปิน</p>}
    </section>
    <section id="links" class="tab-panel" data-tab-panel><h2>ลิงก์ที่เกี่ยวข้อง</h2>
      {catalogSources.length > 0 && <div class="section"><h3>แหล่งอ้างอิง</h3><ul class="plain-list">{catalogSources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><p class="soft">{source.claim}</p></li>)}</ul></div>}
      {relatedLinks.length ? <ul class="plain-list">{relatedLinks.map(row => <li><a href={row.reelUrl} target="_blank" rel="noopener noreferrer">รีวิว {row.title} ↗</a> <span class="muted">· <a href={`/tapes/${encodeURIComponent(row.slug)}`}>ดูข้อมูลเทป</a></span></li>)}</ul> : <p class="empty-state">ยังไม่มีลิงก์รีวิวที่บันทึกไว้กับผลงานของศิลปินนี้</p>}
    </section>
  </Tabs>
  <section class="section"><h2>เสนอแก้ข้อมูลศิลปิน</h2><CorrectionForm turnstileSiteKey={turnstileSiteKey} targetKind="artist" targetId={artist.id} authenticated={Boolean(Astro.locals.user)} loginNext={Astro.url.pathname} client:visible /></section>
  <CreditLine createdByName={artist.createdByName} createdAt={artist.createdAt} updatedByName={artist.updatedByName} updatedAt={artist.updatedAt} />
</BaseLayout>
