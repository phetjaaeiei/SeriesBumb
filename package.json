{
  "name": "seriesbumb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "npm run deploy:prod",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply seriesbumb --local",
    "check:migrations": "node --experimental-strip-types scripts/check-migrations.ts",
    "backup:export": "node --experimental-strip-types scripts/backup-export.ts",
    "backup:storage": "node --experimental-strip-types scripts/backup-storage.ts",
    "restore:export": "node --experimental-strip-types scripts/restore-export.ts",
    "deploy:prod": "node --experimental-strip-types scripts/deploy.ts production",
    "deploy:staging": "node --experimental-strip-types scripts/deploy.ts staging"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "motion": "^13.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.125.0"
  }
}
